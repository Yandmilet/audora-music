# 默认：按平台自动处理换行
* text=auto

# 源码 / 配置统一 LF
*.dart text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.json text eol=lf
*.md text eol=lf
*.properties text eol=lf
*.gradle text eol=lf
*.gradle.kts text eol=lf
*.xml text eol=lf
*.kt text eol=lf

# Windows 批处理必须 CRLF
*.bat text eol=crlf

# 二进制
*.png binary
*.jpg binary
*.webp binary
*.apk binary
*.keystore binary
*.jks binary
