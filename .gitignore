migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Machine-specific config (SDK paths)
local.properties

# Gradle caches kept locally for build speed (never commit)
/android/.gradle/
/android/FlutterDevcachesgradle/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Release signing material —— 绝对禁止入库（口令与私钥明文）
/android/app/key.properties
*.keystore
*.jks

# Widget Preview related
.widget_preview/

# WorkBuddy workspace data (local agent memory)
.workbuddy/

# 真机取证残留：adb 截图、uiautomator dump、从手机拉回来的诊断日志。
# 都是当场看完就没用的东西（生成脚本是 tool/ui_dump.py，它默认就往这里吐文件）。
/shot_*.png
/audora_ui.xml
/ui_*.txt
/ui_dump.txt
/mine_check_*.txt
/diag_*.jsonl
/_diag/

# 改全局 gradle.properties 前留的还原点（配置缓存那条坑见 docs/toolchain-lock.md）
global-gradle.properties.bak-*

# 已从版本控制移除、只留在本机的工作流与 issue 模板（见 82ac2cb）
/.github/
